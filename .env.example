# Canonical site origin — used for metadata, sitemap, robots and OG images.
NEXT_PUBLIC_SITE_URL=https://nithinbahunadam.com

# Optional. When set, /api/contact delivers submissions through Resend.
# Without it the route still validates and accepts submissions, and logs them
# server-side so nothing is silently dropped in local development.
RESEND_API_KEY=
